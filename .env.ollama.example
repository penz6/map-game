# These belong to the Ollama process/service, NOT the game container.
# Set them on the host running your existing Ollama, then restart Ollama.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CONTEXT_LENGTH=32768
# Optional only if your installed AMD backend supports flash attention:
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
# Verify acceleration and memory using `ollama ps` and Ollama logs.
