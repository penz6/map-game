# Copy to .env; Docker Compose reads it. Set your real domain before deployment.
APP_BIND=0.0.0.0
APP_PORT=3000
PUBLIC_ORIGIN=https://game.example.com
HISTORIA_IMAGE=ghcr.io/penz6/map-game:latest
# Host Ollama must listen on an interface reachable from the container.
# Keep its port private with host firewall rules; do not expose it publicly.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
AI_MAX_CONCURRENCY=1
AI_CONTEXT_LENGTH=32768
AI_THINK=default

AI_TIMEOUT_SECONDS=180

# RX 6750 XT 12 GB starting profile; configure Ollama parallelism separately.
AI_BATCH_SIZE=128
AI_TURN_OUTPUT_TOKENS=3072
AI_CHAT_OUTPUT_TOKENS=768
AI_KEEP_ALIVE_SECONDS=300
