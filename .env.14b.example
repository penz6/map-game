# Optional app overrides: merge these into your existing .env (keep origin/URL).
# Pull the model on the Ollama host first: ollama pull qwen2.5:14b
OLLAMA_MODEL=qwen2.5:14b
AI_MAX_CONCURRENCY=1
AI_CONTEXT_LENGTH=32768
AI_BATCH_SIZE=128
AI_TURN_OUTPUT_TOKENS=3072
AI_CHAT_OUTPUT_TOKENS=768
AI_KEEP_ALIVE_SECONDS=300
AI_TIMEOUT_SECONDS=600
AI_THINK=default
# This config does NOT limit Ollama host RAM. See AI.md for a 10 GB service cap.
