# Optional app overrides. Keep your existing origin and Ollama URL.
# Requires a current compatible Ollama with Qwen3.5 structured-output fixes.
# First pull on the Ollama host: ollama pull qwen3.5:9b
OLLAMA_MODEL=qwen3.5:9b
AI_THINK=off
AI_CONTEXT_LENGTH=32768
AI_MAX_CONCURRENCY=1
AI_BATCH_SIZE=128
AI_TURN_OUTPUT_TOKENS=3072
AI_CHAT_OUTPUT_TOKENS=1536
AI_LOAD_TIMEOUT_SECONDS=600
AI_TIMEOUT_SECONDS=600
AI_MAX_DURATION_SECONDS=1800
# Host memory is controlled by the separate Ollama service, not these variables.
